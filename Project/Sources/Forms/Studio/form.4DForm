{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onUnload"
	],
	"windowTitle": "WebP Studio",
	"destination": "detailScreen",
	"method": "method.4dm",
	"pages": [
		{
			"objects": {
				"title": {
					"type": "text",
					"left": 24,
					"top": 14,
					"width": 520,
					"height": 38,
					"text": "WebP Studio",
					"class": "app-title"
				},
				"subtitle": {
					"type": "text",
					"left": 24,
					"top": 54,
					"width": 660,
					"height": 16,
					"text": "A guided tour of miyako/webp 20.0.0: convert, inspect, batch, capabilities, and every failure the component can report.",
					"class": "app-sub"
				},
				"status": {
					"type": "input",
					"left": 700,
					"top": 18,
					"width": 276,
					"height": 26,
					"dataSource": "Form.status",
					"dataSourceTypeHint": "text",
					"enterable": false,
					"class": "pill"
				},
				"tab": {
					"type": "tab",
					"left": 24,
					"top": 86,
					"width": 620,
					"height": 30,
					"labels": [
						"1 Convert",
						"2 Inspector",
						"3 Batch",
						"4 Capabilities",
						"5 Error Lab"
					],
					"action": "gotoPage",
					"fontSize": 12
				}
			}
		},
